        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. Grafik stilini belirleyelim\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "# 2. Duygu dağılımını görselleştirelim\n",
        "counts = df['Duygu'].value_counts()\n",
        "colors = ['#ff9999','#66b3ff'] # Negatif için kırmızımsı, Pozitif için mavimsi\n",
        "\n",
        "plt.pie(counts, labels=counts.index, autopct='%1.1f%%', startangle=140, colors=colors, explode=(0.1, 0))\n",
        "plt.title('Müşteri Memnuniyet Oranı (BERT Analizi)', fontsize=15)\n",
        "plt.show()\n",
        "\n",
        "# 3. Kritik Analiz: Güven Skoru Dağılımı\n",
        "plt.figure(figsize=(10, 5))\n",
        "sns.histplot(df['Güven_Skoru'], kde=True, color='purple')\n",
        "plt.title('Model Tahmin Güven Aralığı', fontsize=15)\n",
        "plt.xlabel('Güven Skoru')\n",
        "plt.ylabel('Yorum Sayısı')\n",
        "plt.show()"
