      "source": [
        "import pandas as pd\n",
        "from transformers import pipeline\n",
        "\n",
        "# 1. Modeli yükle (Dünkü kahramanımız)\n",
        "print(\"🧠 Analiz motoru hazırlanıyor...\")\n",
        "classifier = pipeline(\"sentiment-analysis\", model=\"savasy/bert-base-turkish-sentiment-cased\")\n",
        "\n",
        "# 2. Örnek bir müşteri veri seti oluşturalım (Sanki Excel'den yüklemişiz gibi)\n",
        "data = {\n",
        "    'Müşteri_Yorumu': [\n",
        "        \"Ürün harika ama kargo çok yavaştı, 10 günde geldi.\",\n",
        "        \"Fiyatı biraz pahalı ama kalitesine değer.\",\n",
        "        \"Müşteri hizmetleri hiç yardımcı olmadı, çok kaba davrandılar.\",\n",
        "        \"Paketleme çok özenliydi, teşekkürler!\",\n",
        "        \"Asla tavsiye etmiyorum, param çöp oldu.\"\n",
        "    ]\n",
        "}\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# 3. Toplu Analiz Fonksiyonu\n",
        "def toplu_analiz(liste):\n",
        "    sonuclar = classifier(liste)\n",
        "    return [res['label'] for res in sonuclar], [round(res['score'], 4) for res in sonuclar]\n",
        "\n",
        "# Uygulayalım\n",
        "print(\"📊 Yorumlar analiz ediliyor...\")\n",
        "etiketler, skorlar = toplu_analiz(df['Müşteri_Yorumu'].tolist())\n",
        "\n",
        "df['Duygu'] = etiketler\n",
        "df['Güven_Skoru'] = skorlar\n",
        "\n",
        "# Sonucu görelim\n",
        "print(\"\\n✅ Analiz Tamamlandı! İşte Müşteri İçgörü Raporu:\")\n",
        "print(df)"
      ],
