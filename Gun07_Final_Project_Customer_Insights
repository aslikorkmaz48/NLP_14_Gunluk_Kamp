        "# 1. Otomatik Yanıt Taslakları Oluşturma\n",
        "def yanit_olustur(row):\n",
        "    if row['Duygu'] == 'negative':\n",
        "        # Burada basit bir kural tabanlı üretim yapıyoruz, ileride bunu GPT ile bağlayabiliriz!\n",
        "        if \"kargo\" in row['Müşteri_Yorumu'].lower():\n",
        "            return \"Sayın müşterimiz, kargo sürecindeki gecikme için özür dileriz. Lojistik ekibimize konuyu ilettik.\"\n",
        "        elif \"fiyat\" in row['Müşteri_Yorumu'].lower():\n",
        "            return \"Değerli müşterimiz, fiyatlandırma politikamızı piyasa koşullarına göre sürekli güncelliyoruz. Geri bildiriminiz bizim için değerli.\"\n",
        "        else:\n",
        "            return \"Yaşadığınız olumsuz deneyim için çok üzgünüz. Size yardımcı olabilmemiz için lütfen DM üzerinden iletişime geçin.\"\n",
        "    else:\n",
        "        return \"Bizi tercih ettiğiniz için teşekkür ederiz! Keyifli kullanımlar dileriz. 😊\"\n",
        "\n",
        "# 2. Tablomuza 'Aksiyon_Plani' sütununu ekleyelim\n",
        "df['Aksiyon_Plani'] = df.apply(yanit_olustur, axis=1)\n",
        "\n",
        "# 3. Sonucu Şık Bir Şekilde Görelim\n",
        "print(\"\\n🚀 AKILLI MÜŞTERİ DENEYİMİ MERKEZİ - AKSİYON RAPORU\\n\")\n",
        "print(df[['Müşteri_Yorumu', 'Duygu', 'Aksiyon_Plani']])"
