        "import nest_asyncio\n",
        "from fastapi import FastAPI\n",
        "from pyngrok import ngrok\n",
        "import uvicorn\n",
        "from transformers import pipeline\n",
        "!pip install fastapi uvicorn pyngrok nest-asyncio transformers torch --quiet\n",
        "\n",
        "# 1.\n",
        "sentiment_model = pipeline(\"sentiment-analysis\", model=\"savasy/bert-base-turkish-sentiment-cased\")\n",
        "\n",
        "app = FastAPI(title=\"Asli_NLP_AI_Service_v2\")\n",
        "\n",
        "@app.get(\"/\")\n",
        "def home():\n",
        "    return {\"mesaj\": \"Aslı'nın Duygu Analizi ve NLP API'sine Hoş Geldiniz!\", \"versiyon\": \"2.0\"}\n",
        "\n",
        "@app.get(\"/analiz\")\n",
        "def analiz_et(yorum: str):\n",
        "    # Modelden sonucu al\n",
        "    result = sentiment_model(yorum)[0]\n",
        "\n",
        "    label = \"Pozitif\" if result['label'] == \"positive\" else \"Negatif\"\n",
        "    skor = f\"%{result['score']*100:.2f}\"\n",
        "\n",
        "    return {\n",
        "        \"metin\": yorum,\n",
        "        \"duygu\": label,\n",
        "        \"guven_skoru\": skor,\n",
        "        \"not\": \"BERT-Base-Turkish modeli kullanılmıştır.\"\n",
