        "\n",
        "from transformers import pipeline\n",
        "\n",
        "# 2. Türkçe için eğitilmiş en iyi duygu analizi modellerinden birini çağırıyoruz\n",
        "# Bu model BERT tabanlıdır (Mülakatta \"BERT mimarisini kullandım\" dersin!)\n",
        "sentiment_pipeline = pipeline(\"sentiment-analysis\", model=\"savasy/bert-base-turkish-sentiment-cased\")\n",
        "\n",
        "def duygu_analizi_v2(metin):\n",
        "    result = sentiment_pipeline(metin)[0]\n",
        "\n",
        "    # Modelin sonucunu daha yakışıklı hale getirelim\n",
        "    label = result['label']\n",
        "    score = result['score']\n",
        "\n",
        "    emoji = \"😊\" if label == \"positive\" else \"😠\"\n",
        "    tr_label = \"Pozitif\" if label == \"positive\" else \"Negatif\"\n",
        "\n",
        "    return f\"{tr_label} {emoji} (Güven Skoru: %{score*100:.2f})\"\n",
        "\n",
        "# 3. Test edelim\n",
        "deneme_1 = \"Bu kurs gerçekten harika, çok şey öğrendim!\"\n",
        "deneme_2 = \"Servis çok yavaştı, hiç memnun kalmadım.\"\n",
        "\n",
        "print(f\"Yorum 1: {deneme_1} -> {duygu_analizi_v2(deneme_1)}\")\n",
        "print(f\"Yorum 2: {deneme_2} -> {duygu_analizi_v2(deneme_2)}\")"
