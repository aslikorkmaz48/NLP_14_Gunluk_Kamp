        "import nest_asyncio\n",
        "from fastapi import FastAPI\n",
        "from pyngrok import ngrok\n",
        "import uvicorn\n",
        "from transformers import pipeline\n",
        "\n",
        "# 1. Modeli Hafızaya Yükle\n",
        "print(\"🧠 BERT modeli yükleniyor, lütfen bekleyin...\")\n",
        "sentiment_model = pipeline(\"sentiment-analysis\", model=\"savasy/bert-base-turkish-sentiment-cased\")\n",
        "\n",
        "# 2. API Uygulamasını Başlat\n",
        "app = FastAPI(title=\"Asli_NLP_Sentimental_Service_v2\")\n",
        "\n",
        "@app.get(\"/\")\n",
        "def home():\n",
        "    return {\"durum\": \"Canlı\", \"servis\": \"Duygu Analizi (BERT)\", \"versiyon\": \"2.0\"}\n",
        "\n",
        "@app.get(\"/analiz\")\n",
        "def analiz_et(yorum: str):\n",
        "    # Modelden sonucu al\n",
        "    result = sentiment_model(yorum)[0]\n",
        "\n",
        "    # Etiketi Türkçeleştir ve Emoji ekle\n",
        "    label = \"Pozitif 😊\" if result['label'] == \"positive\" else \"Negatif 😠\"\n",
        "    skor = round(result['score'] * 100, 2)\n",
        "\n",
        "    return {\n",
        "        \"metin\": yorum,\n",
        "        \"duygu_sonucu\": label,\n",
        "        \"guven_skoru\": f\"%{skor}\"\n",
        "    }\n",
        "\n",
        "# --- YAYIN BAŞLIYOR ---\n",
        "ngrok.kill() # Eski tünelleri kapat\n",
        "nest_asyncio.apply()\n",
        "\n",
        "# Tüneli oluştur\n",
        "public_url = ngrok.connect(8000)\n",
        "print(f\"\\n✅ ASLI, SİSTEM HAZIR!\")\n",
        "print(f\"🔗 Test Linki: {public_url}/docs\")\n",
        "\n",
        "# Servisi başlat\n",
        "config = uvicorn.Config(app, host=\"0.0.0.0\", port=8000, log_level=\"info\")\n",
        "server = uvicorn.Server(config)\n",
        "await server.serve()"
