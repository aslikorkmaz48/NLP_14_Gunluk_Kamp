        "print(f\"🔗 Test etmek için bu linke git: {public_url}/docs\")\n",
        "\n",
        "config = uvicorn.Config(app, host=\"0.0.0.0\", port=8000)\n",
        "server = uvicorn.Server(config)\n",
        "await server.serve()"
